<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Essential Permissions strictly required for digital wellbeing -->
    <!-- 1. Usage stats to calculate foreground app screen time -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 2. Re-arm midnight quota resets after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 3. Standard notification alerts for quota warnings (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibration for gentle wellness reminders -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 4. Internet access strictly for checking and downloading genuine in-app updates from GitHub -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 5. Request package installation permission for in-app updates on Android 8.0+ -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 6. Display floating screen-time timer overlay pill over apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 7. Foreground service permissions for persistent floating overlay and continuous timer -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Query declaration for installed launchable apps (Compliant alternative to QUERY_ALL_PACKAGES) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".FocusLockApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusLock">

        <!-- Main Dashboard & Setup Activity -->
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FocusLock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Blocking Overlay Activity (Modern Lockscreen) -->
        <activity
            android:name=".presentation.BlockingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:screenOrientation="portrait"
            android:theme="@style/Theme.FocusLock.Blocking"
            tools:ignore="LockedOrientationActivity" />

        <!-- 30-Minute Continuous Screen Break Alert Activity -->
        <activity
            android:name=".presentation.breakalert.BreakAlertActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.FocusLock.Blocking"
            tools:ignore="LockedOrientationActivity" />

        <!-- Core Accessibility Service for Foreground Monitoring -->
        <service
            android:name=".service.FocusLockAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Persistent Foreground Service for Universal Floating Screen-Time Timer -->
        <service
            android:name=".core.overlay.FloatingTimerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating screen-time timer overlay and continuous screen break monitor" />
        </service>

        <!-- Boot Recovery Receiver -->
        <receiver
            android:name=".service.BootRecoveryReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Time / Timezone Change Receiver -->
        <receiver
            android:name=".service.TimeChangeReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Break Reminder Notification Action Receiver -->
        <receiver
            android:name=".core.util.BreakReminderActionReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.focuslock.app.ACTION_SNOOZE_BREAK_REMINDER" />
                <action android:name="com.focuslock.app.ACTION_DISMISS_BREAK_REMINDER" />
                <action android:name="com.focuslock.app.ACTION_START_BREAK" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for secure in-app APK installation -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
